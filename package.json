{
  "name": "toketeo",
  "version": "0.4.1",
  "description": "Toketeo Database Client and Administration Panel",
  "author": "crdsyntax <crdsyntax@example.com>",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "tauri": "tauri",
    "frontend:dev": "cd frontend && bun run dev",
    "frontend:build": "cd frontend && bun run build",
    "format": "prettier --write \"src-tauri/**/*.rs\" \"frontend/src/**/*.{ts,tsx}\"",
    "lint": "cd frontend && bun run lint",
    "docs:agents": "node scripts/generate-agent-docs.js"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@libsql/linux-x64-gnu": "^0.5.29",
    "libsql": "^0.5.29",
    "mongodb": "^7.3.0",
    "mssql": "^12.5.5",
    "mysql2": "^3.22.5",
    "pg": "^8.21.0",
    "pg-query-stream": "^4.15.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@tauri-apps/cli": "^2.11.2",
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "@types/pg-query-stream": "^3.4.0",
    "@types/ssh2": "^1.15.5",
    "electron": "^41.0.0",
    "electron-builder": "^26.15.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }

}
