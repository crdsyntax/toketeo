{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Toketeo",
  "version": "0.2.0",
  "identifier": "com.toketeo.app",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:8565",
    "beforeDevCommand": "bun run frontend:dev",
    "beforeBuildCommand": "bun run frontend:build"
  },
  "app": {
    "windows": [
      {
        "title": "Toketeo",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ws://localhost:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}