{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Toketeo",
  "version": "0.3.8",
  "identifier": "com.toketeo.app",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:8565",
    "beforeDevCommand": "bun run frontend:dev",
    "beforeBuildCommand": "bun run frontend:build"
  },
  "app": {
    "windows": [
      {
        "title": "Toketeo",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ws://localhost:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2QjlGNkE3MjhBNzlGMkEKUldRcW42Y29wL2E1eHJvbVIyWXh2d1dBd21OZitHMXBoUmsyeEwvV0pGSVJ4dXRVNncydzJmdlYK",
      "endpoints": [
        "https://updates.toketeo.app/latest.json"
      ]
    }
  }
}